# URL de conexión a tu base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/lucy_db"

# Token de tu bot de Telegram proporcionado por BotFather
TELEGRAM_BOT_TOKEN="tu_token_aqui"

# (Opcional) Modelo a usar con Ollama, por defecto gemma4:cloud
OLLAMA_MODEL="gemma4:cloud"

# (Opcional) Puerto donde correrá el servidor Hono, por defecto 3000
PORT="3000"
