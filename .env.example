# URL de conexión a tu base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/lucy_db"

# Token de tu bot de Telegram proporcionado por BotFather
TELEGRAM_BOT_TOKEN="tu_token_aqui"

# ID de tu chat en Telegram (para que solo tú puedas usar el bot)
TELEGRAM_ALLOWED_CHAT_ID="tu_chat_id"

# (Opcional) Modelo a usar con Ollama, por defecto gemma4:cloud
OLLAMA_MODEL="gemma4:cloud"

# (Opcional) Puerto donde correrá el servidor Hono, por defecto 3000
PORT="3000"

# --- CONFIGURACIÓN DE DEVOPS (SSH) ---
# IP o dominio de tu servidor principal
SSH_HOST="tu_ip_servidor"
# Usuario de conexión SSH (ej. root, ubuntu, etc.)
SSH_USERNAME="tu_usuario"
# Contraseña (si usas contraseña en lugar de llaves SSH)
SSH_PASSWORD="tu_password"
# (Opcional) Ruta a tu llave privada (si usas llaves en lugar de contraseña)
SSH_PRIVATE_KEY_PATH="/home/tu_usuario/.ssh/id_rsa"

# --- CONFIGURACIÓN DE KOKORO TTS (Docker) ---
KOKORO_TTS_URL="http://localhost:8880/v1/audio/speech"
KOKORO_VOICE="ef_dora"
